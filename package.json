{
  "name": "resume",
  "private": true,
  "description": "William R. J. Ribeiro's online resume/CV: a static Svelte 5 + Tailwind CSS 4 site on GitHub Pages",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {}
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "bun --bun svelte-kit sync && bun scripts/install-git-hooks.ts",
    "postinstall": "bun scripts/vendor-repos.ts",
    "vendor": "bun scripts/vendor-repos.ts",
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check:hcard": "bun scripts/check-microformats.ts build/index.html",
    "check:svelte": "bun --bun svelte-kit sync && bunx svelte-check@4.7.7 --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "certs": "bun scripts/certs.ts",
    "certs:clean": "rm -rf .certs",
    "serve:https": "bun scripts/serve-https.ts",
    "prd": "bun run build && SERVE_DIR=build bun scripts/serve-https.ts",
    "fmt": "bun run --parallel --workspaces --if-present fmt && oxfmt scripts src test",
    "lint": "bun run --parallel --workspaces --if-present lint && oxlint --disable-nested-config --deny-warnings scripts src test",
    "lint:fix": "bun run --parallel --workspaces --if-present lint:fix",
    "typecheck": "bun --bun svelte-kit sync && bun run --parallel --workspaces --if-present typecheck && bun check",
    "test": "bun run --parallel --workspaces --if-present test && bun test ./scripts ./src",
    "md:check": "rumdl check .",
    "md:fmt": "rumdl fmt .",
    "md:fmt:check": "rumdl fmt --check .",
    "fmt:check": "bun run --parallel --workspaces --if-present fmt:check && oxfmt --check scripts src test",
    "verify": "bun run --parallel --no-exit-on-error fmt:check lint md:check md:fmt:check typecheck test",
    "ci": "bun run --parallel --no-exit-on-error verify build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "agent-browser": "0.38.2",
    "lefthook": "2.1.17",
    "marked": "^18.1.2",
    "microformats-parser": "^2.0.6",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "rumdl": "0.2.78",
    "svelte": "^5.57.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3",
    "yaml": "^2.9.1"
  },
  "trustedDependencies": [
    "agent-browser",
    "lefthook"
  ],
  "version": "3.0.0",
  "author": "William R. J. Ribeiro",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamrjribeiro/resume"
  }
}
