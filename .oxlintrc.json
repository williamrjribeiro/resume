{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "oxc", "eslint", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  // `svelte` predefines the runes ($props, $state, $derived, ...) and `browser` the DOM globals, so that
  // rules which look for undefined names work in .svelte files, which Oxlint lints script block by script block.
  "env": { "builtin": true, "browser": true, "svelte": true },
  "ignorePatterns": ["repos/**", "**/dist/**", "**/coverage/**", "build/**", ".svelte-kit/**"],
  "rules": {
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "eslint/require-yield": "off",
    "eslint/no-shadow": "off",
    "eslint/no-unused-vars": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      // TypeScript already reports undefined names in .ts files (`bun check`); Oxlint is the only
      // linter that reads the script blocks of .svelte files.
      "files": ["**/*.svelte"],
      "rules": { "eslint/no-undef": "error" }
    },
    {
      // Test suites and scripts report to stdout.
      "files": ["**/test/**", "**/scripts/**", "**/cli/**"],
      "rules": { "eslint/no-console": "off" }
    }
  ]
}
