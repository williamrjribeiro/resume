{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "oxc", "eslint", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": ["repos/**", "**/dist/**", "**/coverage/**", "**/storybook-static/**"],
  "rules": {
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "eslint/require-yield": "off",
    "eslint/no-shadow": "off",
    "eslint/no-unused-vars": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      // Test suites and scripts report to stdout.
      "files": ["**/test/**", "**/scripts/**", "**/cli/**"],
      "rules": { "eslint/no-console": "off" }
    }
  ]
}
